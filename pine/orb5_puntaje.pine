//@version=6
// =====================================================================================
// ORB 5m NQ/ES con puntaje (futbot) · github.com/AlejandroKY/BOTtrading
// Mismas reglas que las recetas `nq_orb5_puntaje` y `es_orb5_puntaje` de futbot (verificado con un
// port 1:1 en Python). Úsalo en un gráfico de 1 o 5 minutos de NQ1!/MNQ1! y otro de ES1!/MES1!.
//   1. Día en juego: |apertura 9:30 - cierre 16:00 de ayer| >= 0,15 x ATR(14) diario.
//   2. Vela de 9:30 a 9:35: verde -> COMPRA a las 9:35; roja -> VENTA. Stop: mitad de la vela.
//   3. Puntaje 0-100: cierra fuera del rango overnight (30) + cuerpo fuerte (hasta 25) + gap grande
//      (hasta 20) + abrió fuera del rango de ayer (15) + lunes (10). Se opera con 40 o más.
//   4. Un trade por día: NQ primero; ES sólo si NQ no califica.
//   5. Salidas: con 2+ contratos, la mitad en +2R y el resto con stop en la entrada; resto a 10R
//      o a las 10:35. Con 1 contrato, sin parcial.
//   6. Riesgo por escalones según el colchón sobre el límite de la cuenta: $300 / $200 / $100.
// Herramienta de estudio, no asesoría financiera.
// =====================================================================================
indicator("ORB 5m NQ/ES con puntaje (futbot)", shorttitle = "ORB5 puntaje", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ------------------------------------------------------------------- Entradas
grpE = "Estrategia"
minScore  = input.int(40, "Puntaje mínimo para operar", minval = 0, maxval = 100, group = grpE, tooltip = "40 = recomendado (~1 trade por semana). 60 = menos trades y más acierto. 80 = sólo las mejores (~6 al año).")
selMode   = input.string("NQ primero (recomendado)", "Si NQ y ES califican", options = ["NQ primero (recomendado)", "Mejor puntaje"], group = grpE)
usePart   = input.bool(true, "Tomar la mitad en +2R y mover el stop a la entrada", group = grpE)
partR     = input.float(2.0, "Parcial en (R)", minval = 0.5, step = 0.5, group = grpE)
targetR   = input.float(10.0, "Take profit final (R)", minval = 1.0, step = 0.5, group = grpE)
holdMin   = input.int(60, "Salida por tiempo (minutos después de entrar)", minval = 5, maxval = 120, step = 5, group = grpE)
minGapAtr = input.float(0.15, "Gap mínimo (× ATR diario)", minval = 0.0, step = 0.05, group = grpE)
atrLen    = input.int(14, "Días del ATR", minval = 2, group = grpE)
adjRolls  = input.bool(true, "Ajustar cambios de contrato (recomendado)", group = grpE)

grpM = "Mercados"
nqSym = input.symbol("CME_MINI:NQ1!", "Nasdaq", group = grpM)
esSym = input.symbol("CME_MINI:ES1!", "S&P 500", group = grpM)

grpR = "Riesgo"
riskMode = input.string("Escalones según colchón (recomendado)", "Riesgo por operación", options = ["Escalones según colchón (recomendado)", "Fijo"], group = grpR, tooltip = "Escalones: $300 si te quedan $1.400 o más sobre el límite de pérdida de la cuenta, $200 entre $800 y $1.400, y $100 por debajo. En la simulación de cuentas de 50K suspende mucho menos que un riesgo fijo.")
cushionIn = input.float(2000.0, "Colchón actual sobre el límite (USD)", minval = 0, step = 50, group = grpR, tooltip = "Saldo de la cuenta menos el nivel donde la pierdes (en LucidFlex/Topstep aparece como pérdida máxima restante). Al empezar una cuenta de 50K es $2.000. Actualízalo después de cada trade.")
riskFix  = input.float(200.0, "Riesgo fijo (USD)", minval = 10, step = 10, group = grpR, tooltip = "Sólo si elegiste 'Fijo'. Para una cuenta de 50K: $200.")
sizeMode = input.string("Micro (MNQ / MES)", "Contratos", options = ["Micro (MNQ / MES)", "Mini (NQ / ES)"], group = grpR)
maxQty   = input.int(50, "Máximo de contratos", minval = 1, group = grpR)
costNq   = input.float(1.2, "Costo por operación NQ (puntos)", minval = 0, step = 0.1, group = grpR, tooltip = "Comisión + deslizamiento de ida y vuelta. El stop mínimo es 5 veces este costo (NQ: 6 puntos).")
costEs   = input.float(0.8, "Costo por operación ES (puntos)", minval = 0, step = 0.1, group = grpR, tooltip = "ES: stop mínimo 4 puntos.")
stepRisk(float c) => c >= 1400 ? 300.0 : c >= 800 ? 200.0 : 100.0
var float riskUsd = riskMode == "Fijo" ? riskFix : stepRisk(cushionIn)

grpV = "Visual"
showSkip  = input.bool(true, "Mostrar días sin operación (y por qué)", group = grpV)
showOn    = input.bool(true, "Líneas del rango overnight y del cierre de ayer", group = grpV)
showPanel = input.bool(true, "Mostrar panel", group = grpV)
panelPos  = input.string("Arriba derecha", "Posición del panel", options = ["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"], group = grpV)
colBuy    = input.color(#1f9d55, "Compras", group = grpV, inline = "c")
colSell   = input.color(#d64545, "Ventas", group = grpV, inline = "c")

// ------------------------------------------------------------------- Constantes y utilidades
TZ       = "America/New_York"
OPEN_MIN = 9 * 60 + 30
OR_END   = OPEN_MIN + 5
RTH_END  = 16 * 60
ON_START = 18 * 60
EXIT_MIN = OR_END + holdMin
TICK     = 0.25
micro    = sizeMode == "Micro (MNQ / MES)"
pvNq     = micro ? 2.0 : 20.0
pvEs     = micro ? 5.0 : 50.0
GRAY     = color.new(#787b86, 0)

fPx(float x) => str.tostring(x, "#.00")
fR(float x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.0") + "R"
fUsd(float x) => (x < 0 ? "-$" : "+$") + str.tostring(math.abs(math.round(x)), "#,###")
fMoney(float x) => "$" + str.tostring(math.abs(math.round(x)), "#,###")
fHM(int m) => str.tostring(math.floor(m / 60)) + ":" + str.format("{0,number,00}", m % 60)
roundDown(float x) => math.floor(math.round(x / TICK, 6)) * TICK
roundUp(float x) => math.ceil(math.round(x / TICK, 6)) * TICK
clamp01(float x) => math.max(0.0, math.min(1.0, x))

// ------------------------------------------------------------------- Datos de cada mercado
// Se calcula dentro del contexto de cada símbolo (sesión completa y ajustado por roll): vela de
// 9:30-9:35, rango overnight (18:00 a 9:29), máximo/mínimo/cierre del horario cash de ayer.
orData() =>
    tm  = hour(time, TZ) * 60 + minute(time, TZ)
    tcm = hour(time_close, TZ) * 60 + minute(time_close, TZ)
    dk  = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
    rth = tm >= OPEN_MIN and tm < RTH_END
    var float curC = na
    var float curH = na
    var float curL = na
    var float pC   = na
    var float pH   = na
    var float pL   = na
    var int   cDay = na
    var float onH  = na
    var float onL  = na
    var float oO   = na
    var float oH   = na
    var float oL   = na
    var float oOnH = na
    var float oOnL = na
    var int   oDay = na
    var int   prevTm = na
    // rango overnight: empieza en la primera vela desde las 18:00
    if tm >= ON_START and (na(prevTm) or prevTm < ON_START)
        onH := high
        onL := low
    else if tm >= ON_START or tm < OPEN_MIN
        onH := na(onH) ? high : math.max(onH, high)
        onL := na(onL) ? low : math.min(onL, low)
    prevTm := tm
    if rth
        if na(cDay) or dk != cDay
            pC := curC
            pH := curH
            pL := curL
            cDay := dk
            curH := high
            curL := low
        else
            curH := math.max(curH, high)
            curL := math.min(curL, low)
        curC := close
    if rth and tm == OPEN_MIN
        oDay := dk
        oO   := open
        oH   := high
        oL   := low
        oOnH := onH
        oOnL := onL
    else if rth and tm < OR_END and oDay == dk
        oH := math.max(oH, high)
        oL := math.min(oL, low)
    done = rth and oDay == dk and tcm == OR_END
    [done, oO, oH, oL, close, oOnH, oOnL, pH, pL, pC]

// Puntaje y validez de la señal de un mercado (mismas reglas que futbot/strategies/puntaje.py)
signal(bool done, float oO, float oH, float oL, float oC, float onH, float onL, float pH, float pL, float pC, float atr, float pv, float cost, bool monday, float rUsd) =>
    dir    = oC > oO ? 1 : oC < oO ? -1 : 0
    gapAtr = math.abs(oO - pC) / atr
    rng    = oH - oL
    mid    = (oH + oL) / 2
    stop   = dir > 0 ? roundDown(mid) : roundUp(mid)
    risk   = (oC - stop) * dir
    body   = rng > 0 ? math.abs(oC - oO) / rng : 0.0
    sOn    = (dir > 0 ? oC > onH : oC < onL) ? 30.0 : 0.0
    sBody  = 25.0 * clamp01((body - 0.3) / 0.5)
    sGap   = na(gapAtr) ? 0.0 : 20.0 * clamp01((gapAtr - 0.15) / 0.45)
    sPd    = (dir > 0 ? oO > pH : oO < pL) ? 15.0 : 0.0
    sMon   = monday ? 10.0 : 0.0
    score  = math.floor(sOn + sBody + sGap + sPd + sMon + 0.5)
    nCt    = risk > 0 ? math.min(maxQty, math.floor(rUsd / (risk * pv))) : 0
    why    = not done ? "sin datos" : na(gapAtr) or gapAtr < minGapAtr ? "gap chico" : dir == 0 ? "vela sin dirección" : rng < 4 * TICK ? "vela muy chica" : risk <= 0 ? "cierre detrás de la mitad" : risk < 5 * cost ? "stop muy cerca" : score < minScore ? "puntaje " + str.tostring(score) + " < " + str.tostring(minScore) : nCt < 1 ? "riesgo " + fMoney(risk * pv) + " > " + fMoney(rUsd) : ""
    detail = "overnight " + str.tostring(sOn, "0") + " · cuerpo " + str.tostring(sBody, "0") + " · gap " + str.tostring(sGap, "0") + " · fuera de ayer " + str.tostring(sPd, "0") + " · lunes " + str.tostring(sMon, "0")
    [dir, stop, risk, score, nCt, why, detail, gapAtr]

tkFor(simple string sym) => ticker.modify(sym, session = session.extended, backadjustment = adjRolls ? backadjustment.on : backadjustment.inherit, settlement_as_close = settlement_as_close.off)
tkNq = tkFor(nqSym)
tkEs = tkFor(esSym)
[nDone, nO, nH, nL, nC, nOnH, nOnL, nPH, nPL, nPC] = request.security(tkNq, timeframe.period, orData(), gaps = barmerge.gaps_on)
[eDone, eO, eH, eL, eC, eOnH, eOnL, ePH, ePL, ePC] = request.security(tkEs, timeframe.period, orData(), gaps = barmerge.gaps_on)
nAtr = request.security(tkNq, "D", ta.atr(atrLen)[1], lookahead = barmerge.lookahead_on)
eAtr = request.security(tkEs, "D", ta.atr(atrLen)[1], lookahead = barmerge.lookahead_on)

// ------------------------------------------------------------------- Tiempo del gráfico
tMin   = hour(time, TZ) * 60 + minute(time, TZ)
tcMin  = hour(time_close, TZ) * 60 + minute(time_close, TZ)
dayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
inRth  = tMin >= OPEN_MIN and tMin < RTH_END
tfOk   = timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 5)
root   = syminfo.root
chartMkt = root == "NQ" or root == "MNQ" ? 1 : root == "ES" or root == "MES" ? 2 : 0
mktName(int m) => m == 1 ? "NQ" : m == 2 ? "ES" : "—"
cName = chartMkt == 1 ? (micro ? "MNQ" : "NQ") : (micro ? "MES" : "ES")
pvChart = chartMkt == 2 ? pvEs : pvNq
costChart = chartMkt == 2 ? costEs : costNq
monday = dayofweek(time, TZ) == dayofweek.monday

// Vela de 9:30 en precios del gráfico (para dibujar y operar)
var int   orDay = na
var int   orT0  = na
var float orO   = na
var float orH   = na
var float orL   = na
if inRth and tMin == OPEN_MIN
    orDay := dayKey
    orT0  := time
    orO   := open
    orH   := high
    orL   := low
else if inRth and tMin < OR_END and orDay == dayKey
    orH := math.max(orH, high)
    orL := math.min(orL, low)

// ------------------------------------------------------------------- Estado
var int    sigDir  = 0
var float  sigStop = na
var int    sigQty  = 0
var int    pos     = 0
var int    posDay  = na
var int    posBar  = na
var float  entryPx = na
var float  stopPx  = na
var float  stop0   = na
var float  tp1Px   = na
var float  tpPx    = na
var float  riskPts = na
var int    qty     = 0
var int    qtyPart = 0
var bool   partDone = false
var bool   bePending = false
var float  partPts = 0.0
var box    bxRisk  = na
var box    bxTp1   = na
var line   lnEntry = na
var string sNq = "—"
var string sEs = "—"
var string sSel = "Esperando la vela de 9:30 (señal a las 9:35)"
var string sNiv = "—"
var string sEstado = "Sin operación"
var color  cEstado = GRAY
var color  cSel = GRAY
var int    sDay = na
var int   nOps = 0
var int   nWin = 0
var float sumR = 0.0
var float sumUsd = 0.0
var int   streak = 0
var int   maxStrk = 0

if na(sDay) or dayKey != sDay
    sDay    := dayKey
    sNq     := "—"
    sEs     := "—"
    sSel    := "Esperando la vela de 9:30 (señal a las 9:35)"
    sNiv    := "—"
    sEstado := "Sin operación"
    cEstado := GRAY
    cSel    := GRAY

buySig  = false
sellSig = false
exitNow = false
stopHit = false
tp1Hit  = false

closeTrade(float px, string why) =>
    restPts = (px - entryPx) * pos
    qDone   = partDone ? qtyPart : 0
    netPts  = (partPts * qDone + restPts * (qty - qDone)) / qty - costChart
    r       = netPts / riskPts
    usd     = netPts * pvChart * qty
    col     = r > 0 ? colBuy : r < 0 ? colSell : GRAY
    label.new(time, px, fR(r) + "  " + fUsd(usd), xloc = xloc.bar_time, color = color.new(col, 10), textcolor = color.white, style = label.style_label_left, size = size.small, tooltip = why + " a " + fPx(px) + "\nEntrada " + fPx(entryPx) + " · stop inicial " + fPx(stop0) + (qtyPart > 0 ? "\nParcial: " + (partDone ? str.tostring(qtyPart) + " " + cName + " en " + fPx(tp1Px) : "no se tocó") : "") + "\nResultado neto de costos: " + fR(r) + " = " + fUsd(usd) + " con " + str.tostring(qty) + " " + cName)
    box.set_right(bxRisk, time_close)
    box.set_right(bxTp1, time_close)
    line.set_x2(lnEntry, time_close)
    [r, usd, col]

// ------------------------------------------------------------------- 1) 9:35: puntaje de NQ y ES
orDone = barstate.isconfirmed and tfOk and inRth and orDay == dayKey and tcMin == OR_END
if orDone
    [nDir, nStop, nRisk, nScore, nQty, nWhy, nDet, nGap] = signal(nDone, nO, nH, nL, nC, nOnH, nOnL, nPH, nPL, nPC, nAtr, pvNq, costNq, monday, riskUsd)
    [eDir, eStop, eRisk, eScore, eQty, eWhy, eDet, eGap] = signal(eDone, eO, eH, eL, eC, eOnH, eOnL, ePH, ePL, ePC, eAtr, pvEs, costEs, monday, riskUsd)
    nOk = nWhy == ""
    eOk = eWhy == ""
    sel = selMode == "Mejor puntaje" ? (nOk and (not eOk or nScore >= eScore) ? 1 : eOk ? 2 : 0) : (nOk ? 1 : eOk ? 2 : 0)
    sNq := (nDir > 0 ? "▲ " : nDir < 0 ? "▼ " : "") + "puntaje " + (na(nScore) ? "—" : str.tostring(nScore)) + (nOk ? " ✓" : " · " + nWhy)
    sEs := (eDir > 0 ? "▲ " : eDir < 0 ? "▼ " : "") + "puntaje " + (na(eScore) ? "—" : str.tostring(eScore)) + (eOk ? " ✓" : " · " + eWhy)
    sSel := sel == 0 ? "Hoy no se opera" : "Hoy se opera " + mktName(sel) + (sel == chartMkt ? " (este gráfico)" : " → abre el gráfico de " + mktName(sel))
    cSel := sel == 0 ? GRAY : sel == 1 ? (nDir > 0 ? colBuy : colSell) : (eDir > 0 ? colBuy : colSell)
    // dibujo y señal en el gráfico del mercado elegido
    myDir   = chartMkt == 1 ? nDir : eDir
    myScore = chartMkt == 1 ? nScore : eScore
    myDet   = chartMkt == 1 ? nDet : eDet
    myWhy   = chartMkt == 1 ? nWhy : eWhy
    myOnH   = chartMkt == 1 ? nOnH : eOnH
    myOnL   = chartMkt == 1 ? nOnL : eOnL
    myPC    = chartMkt == 1 ? nPC : ePC
    myO     = chartMkt == 1 ? nO : eO
    off     = myO - orO   // ajuste por roll: precio ajustado - precio del gráfico
    exitT   = time_close + holdMin * 60000
    if showOn and chartMkt != 0 and (sel == chartMkt or showSkip)
        if not na(myOnH)
            line.new(orT0, myOnH - off, exitT, myOnH - off, xloc = xloc.bar_time, color = color.new(#5b9cf6, 30), style = line.style_dotted)
            label.new(exitT, myOnH - off, "máx overnight", xloc = xloc.bar_time, color = color(na), textcolor = color.new(#5b9cf6, 0), style = label.style_label_left, size = size.tiny)
        if not na(myOnL)
            line.new(orT0, myOnL - off, exitT, myOnL - off, xloc = xloc.bar_time, color = color.new(#5b9cf6, 30), style = line.style_dotted)
            label.new(exitT, myOnL - off, "mín overnight", xloc = xloc.bar_time, color = color(na), textcolor = color.new(#5b9cf6, 0), style = label.style_label_left, size = size.tiny)
        if not na(myPC)
            line.new(orT0, myPC - off, exitT, myPC - off, xloc = xloc.bar_time, color = color.new(GRAY, 30), style = line.style_dotted)
            label.new(exitT, myPC - off, "cierre ayer", xloc = xloc.bar_time, color = color(na), textcolor = GRAY, style = label.style_label_left, size = size.tiny)
    if chartMkt != 0 and sel == chartMkt
        // niveles en precios del gráfico (iguales al cálculo ajustado salvo el desplazamiento del roll)
        mid  = (orH + orL) / 2
        stop = myDir > 0 ? roundDown(mid) : roundUp(mid)
        rk   = (close - stop) * myDir
        q    = math.min(maxQty, math.floor(riskUsd / (rk * pvChart)))
        sigDir  := myDir
        sigStop := stop
        sigQty  := q
        buySig  := myDir > 0
        sellSig := myDir < 0
        col = myDir > 0 ? colBuy : colSell
        qp  = usePart and q >= 2 ? math.floor(q / 2) : 0
        sNiv := "entrada ~" + fPx(close) + " · stop " + fPx(stop) + " · " + str.tostring(q) + " " + cName
        sEstado := "Entrando a las 9:35"
        cEstado := col
        box.new(orT0, orH, time_close, orL, xloc = xloc.bar_time, border_color = color.new(col, 40), bgcolor = color.new(col, 88), text = "vela 9:30", text_size = size.tiny, text_color = color.new(col, 20), text_valign = text.align_top)
        label.new(time_close, myDir > 0 ? orL : orH, (myDir > 0 ? "COMPRA " : "VENTA ") + str.tostring(myScore), xloc = xloc.bar_time, color = col, textcolor = color.white, style = myDir > 0 ? label.style_label_up : label.style_label_down, size = size.normal, tooltip = (myDir > 0 ? "COMPRA " : "VENTA ") + str.tostring(q) + " " + cName + " a mercado (9:35)\nPuntaje " + str.tostring(myScore) + "/100: " + myDet + "\nStop: " + fPx(stop) + " (riesgo ~" + fUsd(-q * rk * pvChart) + ")" + (qp > 0 ? "\nTP1 +" + str.tostring(partR, "0.#") + "R: cerrar " + str.tostring(qp) + " y mover el stop a la entrada" : "") + "\nTP final " + str.tostring(targetR, "0.#") + "R · salida por tiempo " + fHM(EXIT_MIN))
        alert((myDir > 0 ? "COMPRA " : "VENTA ") + mktName(chartMkt) + " (puntaje " + str.tostring(myScore) + "): " + str.tostring(q) + " " + cName + " a mercado ~" + fPx(close) + " | STOP " + fPx(stop) + (qp > 0 ? " | TP1 " + fPx(close + myDir * partR * rk) + " (cerrar " + str.tostring(qp) + ")" : "") + " | TP " + fPx(close + myDir * targetR * rk) + " | cerrar a las " + fHM(EXIT_MIN) + " NY", alert.freq_once_per_bar_close)
    else if chartMkt != 0 and showSkip
        box.new(orT0, orH, time_close, orL, xloc = xloc.bar_time, border_color = color.new(GRAY, 50), bgcolor = color.new(GRAY, 90))
        label.new(orT0, orH, (sel != 0 ? "se opera " + mktName(sel) : "sin trade: " + myWhy) + " · " + str.tostring(myScore), xloc = xloc.bar_time, color = color(na), textcolor = GRAY, style = label.style_label_down, size = size.small, tooltip = "NQ: " + sNq + "\nES: " + sEs + "\nPuntaje de este mercado: " + myDet)

// ------------------------------------------------------------------- 2) 9:35: entrada a mercado
else if sigDir != 0
    e = open
    if (sigStop - e) * sigDir < 0 and dayKey == orDay
        pos      := sigDir
        posDay   := dayKey
        posBar   := bar_index
        entryPx  := e
        stopPx   := sigStop
        stop0    := sigStop
        riskPts  := math.abs(e - sigStop)
        qty      := sigQty
        qtyPart  := usePart and qty >= 2 ? math.floor(qty / 2) : 0
        tp1Px    := math.round((e + pos * partR * riskPts) / TICK) * TICK
        tpPx     := math.round((e + pos * targetR * riskPts) / TICK) * TICK
        partDone := false
        bePending := false
        partPts  := 0.0
        col      = pos > 0 ? colBuy : colSell
        tEnd     = time + holdMin * 60000
        bxRisk  := box.new(time, math.max(e, stopPx), tEnd, math.min(e, stopPx), xloc = xloc.bar_time, border_color = color.new(colSell, 60), bgcolor = color.new(colSell, 82), text = "STOP " + fPx(stopPx) + "   " + fUsd(-riskPts * pvChart * qty) + " · " + str.tostring(qty) + " " + cName, text_size = size.small, text_color = color.new(colSell, 0), text_halign = text.align_left, text_valign = pos > 0 ? text.align_bottom : text.align_top)
        bxTp1   := box.new(time, math.max(e, tp1Px), tEnd, math.min(e, tp1Px), xloc = xloc.bar_time, border_color = color.new(colBuy, 60), bgcolor = color.new(colBuy, 85), text = qtyPart > 0 ? "TP1 " + fPx(tp1Px) + " · cerrar " + str.tostring(qtyPart) + " y stop a la entrada" : "+" + str.tostring(partR, "0.#") + "R (" + fPx(tp1Px) + ")", text_size = size.small, text_color = color.new(colBuy, 0), text_halign = text.align_left, text_valign = pos > 0 ? text.align_top : text.align_bottom)
        lnEntry := line.new(time, e, tEnd, e, xloc = xloc.bar_time, color = color.new(col, 0), width = 2)
        label.new(tEnd, e, "entrada " + fPx(e) + " · salir " + fHM(EXIT_MIN), xloc = xloc.bar_time, color = color(na), textcolor = col, style = label.style_label_left, size = size.small)
        sNiv := "entrada " + fPx(e) + " · stop " + fPx(stopPx) + (qtyPart > 0 ? " · TP1 " + fPx(tp1Px) : "") + " · TP " + fPx(tpPx)
    else
        sEstado := "Cancelada: abrió más allá del stop"
    sigDir := 0

// ------------------------------------------------------------------- 3) gestión: stop, parcial, TP, tiempo
if pos != 0
    if bePending
        stopPx := entryPx
        bePending := false
    same    = bar_index == posBar
    hitStop = pos > 0 ? low <= stopPx : high >= stopPx
    px  = float(na)
    why = ""
    if dayKey != posDay
        px  := open
        why := "Cierre de emergencia (otro día)"
    else if hitStop
        px  := same ? stopPx : pos > 0 ? math.min(open, stopPx) : math.max(open, stopPx)
        why := partDone and stopPx == entryPx ? "Stop en la entrada (tras el parcial)" : "Stop"
        stopHit := true
    else
        if qtyPart > 0 and not partDone and (pos > 0 ? high >= tp1Px + TICK : low <= tp1Px - TICK)
            fill = same ? tp1Px : pos > 0 ? math.max(open, tp1Px) : math.min(open, tp1Px)
            partPts := (fill - entryPx) * pos
            partDone := true
            bePending := true
            tp1Hit := true
            box.set_text(bxTp1, "TP1 ✓ " + str.tostring(qtyPart) + " " + cName + " cerrados · stop a la entrada")
            alert("TP1 " + mktName(chartMkt) + ": cierra " + str.tostring(qtyPart) + " " + cName + " (~" + fPx(fill) + ") y mueve el stop a la entrada " + fPx(entryPx), alert.freq_once_per_bar)
        if pos > 0 ? high >= tpPx + TICK : low <= tpPx - TICK
            px  := same ? tpPx : pos > 0 ? math.max(open, tpPx) : math.min(open, tpPx)
            why := "Take profit " + str.tostring(targetR, "0.#") + "R"
        else if barstate.isconfirmed and tcMin >= EXIT_MIN
            px  := close
            why := "Salida por tiempo " + fHM(EXIT_MIN)
            exitNow := true
    if not na(px)
        [r, usd, col] = closeTrade(px, why)
        nOps   += 1
        nWin   += r > 0 ? 1 : 0
        sumR   += r
        sumUsd += usd
        streak := r > 0 ? 0 : streak + 1
        maxStrk := math.max(maxStrk, streak)
        sEstado := "Cerrada " + fR(r) + " (" + why + ")"
        cEstado := col
        side = pos > 0 ? "compra" : "venta"
        if stopHit
            alert("STOP " + mktName(chartMkt) + ": " + side + " cerrada en ~" + fPx(px) + " (" + fR(r) + ")", alert.freq_once_per_bar)
        else if exitNow
            alert("SALIDA " + fHM(EXIT_MIN) + " " + mktName(chartMkt) + ": cierra la " + side + " a mercado ahora (~" + fPx(px) + ", " + fR(r) + ")", alert.freq_once_per_bar_close)
        else
            alert(why + " " + mktName(chartMkt) + ": " + side + " cerrada en ~" + fPx(px) + " (" + fR(r) + ")", alert.freq_once_per_bar)
        pos := 0
    else
        rNow = ((partDone ? partPts * qtyPart : 0.0) + (close - entryPx) * pos * (qty - (partDone ? qtyPart : 0))) / qty / riskPts
        sEstado := "En curso " + fR(rNow) + (partDone ? " · parcial ✓, stop en la entrada" : "") + " · cierra " + fHM(EXIT_MIN)
        cEstado := rNow >= 0 ? colBuy : colSell

alertcondition(buySig, "Señal de COMPRA", "ORB5 puntaje: COMPRA a mercado (ver stop y salida en el gráfico)")
alertcondition(sellSig, "Señal de VENTA", "ORB5 puntaje: VENTA a mercado (ver stop y salida en el gráfico)")
alertcondition(tp1Hit, "TP1: parcial", "ORB5 puntaje: TP1 tocado, cierra la mitad y mueve el stop a la entrada")
alertcondition(exitNow, "Salida por tiempo", "ORB5 puntaje: cerrar la posición (salida por tiempo)")
alertcondition(stopHit, "Stop tocado", "ORB5 puntaje: el precio tocó el stop")

// ------------------------------------------------------------------- Panel
tblPos = panelPos == "Arriba izquierda" ? position.top_left : panelPos == "Abajo derecha" ? position.bottom_right : panelPos == "Abajo izquierda" ? position.bottom_left : position.top_right
var table tbl = table.new(tblPos, 2, 9, bgcolor = color.new(#131722, 10), frame_color = color.new(GRAY, 60), frame_width = 1, border_color = color.new(GRAY, 85), border_width = 1)

cell(int row, string k, string v, color c) =>
    table.cell(tbl, 0, row, k, text_color = GRAY, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, v, text_color = c, text_size = size.small, text_halign = text.align_left)

if showPanel and barstate.isfirst
    table.cell(tbl, 0, 0, "ORB 5m NQ/ES con puntaje ≥ " + str.tostring(minScore) + " · riesgo " + fMoney(riskUsd) + (riskMode == "Fijo" ? "" : " (colchón " + fMoney(cushionIn) + ")"), text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(tbl, 0, 0, 1, 0)
if showPanel and barstate.islast
    if not tfOk or chartMkt == 0
        cell(1, "Aviso", not tfOk ? "Usa un gráfico de 1 o 5 minutos" : "Abre NQ1!/MNQ1! o ES1!/MES1!", colSell)
    else
        cell(1, "Hoy", sSel, cSel)
    cell(2, "NQ", sNq, str.contains(sNq, "✓") ? colBuy : GRAY)
    cell(3, "ES", sEs, str.contains(sEs, "✓") ? colBuy : GRAY)
    cell(4, "Niveles", sNiv, color.white)
    cell(5, "Estado", sEstado, cEstado)
    statTxt = nOps == 0 ? "sin operaciones de " + mktName(chartMkt) + " en el historial cargado" : str.tostring(nOps) + " trades · " + str.tostring(100.0 * nWin / nOps, "0") + "% acierto · " + fR(sumR / nOps) + " prom · " + fUsd(sumUsd) + " · peor racha " + str.tostring(maxStrk)
    cell(6, "En este gráfico", statTxt, nOps == 0 ? GRAY : sumR >= 0 ? colBuy : colSell)
    cell(7, "Backtest NQ 19-26", "43% acierto · +0.37R por trade · ~1 por semana · 8 de 8 años +", GRAY)
    cell(8, "Por puntaje", "40-59: 36% · 60-79: 45% · 80+: 60% de acierto", GRAY)
