//@version=6
// =====================================================================================
// ORB 5m NQ · Señales (futbot)
// Mismas reglas que la receta `nq_orb5_gap` de futbot (github.com/AlejandroKY/BOTtrading):
//   1. Rango de apertura = vela de los primeros 5 minutos de Nueva York (09:30-09:35).
//   2. Filtro "día en juego": |apertura 09:30 - cierre 16:00 de ayer| >= 0,30 x ATR(14) diario.
//   3. Vela alcista -> COMPRA a mercado a las 09:35. Bajista -> VENTA. Doji -> nada.
//   4. Stop: mínimo de la vela (compras) / máximo (ventas). Take profit: 10R (casi nunca se toca).
//   5. Si no tocó el stop ni el take profit, se cierra a las 11:30.
// Usar en NQ1! o MNQ1!, gráfico de 1 o 5 minutos. Herramienta de estudio, no asesoría financiera.
// =====================================================================================
indicator("ORB 5m NQ · Señales (futbot)", shorttitle = "ORB5 NQ", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ------------------------------------------------------------------- Entradas
TZ = "America/New_York"

grpE = "Estrategia"
orMin        = input.int(5, "Minutos del rango de apertura", minval = 1, maxval = 60, group = grpE)
exitHour     = input.int(11, "Hora de salida (NY)", minval = 9, maxval = 15, group = grpE, inline = "salida")
exitMinute   = input.int(30, ":", minval = 0, maxval = 59, group = grpE, inline = "salida")
targetR      = input.float(10.0, "Take profit (en R = veces el riesgo)", minval = 0.5, step = 0.5, group = grpE)
useGap       = input.bool(true, "Filtro 'día en juego' (gap grande)", group = grpE)
minGapAtr    = input.float(0.30, "Gap mínimo (× ATR diario)", minval = 0.0, step = 0.05, group = grpE)
atrLen       = input.int(14, "Días del ATR", minval = 2, group = grpE)
dirMode      = input.string("Ambas", "Dirección", options = ["Ambas", "Solo compras", "Solo ventas"], group = grpE)
minRangeTick = input.int(4, "Rango mínimo de la vela (ticks)", minval = 1, group = grpE)

grpR = "Riesgo y cuenta"
riskUsd      = input.float(150.0, "Riesgo por operación (USD)", minval = 10, step = 10, group = grpR, tooltip = "Lo que pierdes si toca el stop. Recomendado en Topstep 50K: $150 (aguanta 13 pérdidas seguidas antes del límite de $2.000; la peor racha histórica fue de 20).")
contractSel  = input.string("MNQ (micro, $2/punto)", "Contrato que operas", options = ["MNQ (micro, $2/punto)", "NQ (mini, $20/punto)"], group = grpR)
skipTooBig   = input.bool(true, "Saltar señales que no caben en tu riesgo", group = grpR, tooltip = "Si ni 1 contrato cabe en tu riesgo por operación, la señal se marca pero no se opera ni cuenta en las estadísticas.")
maxContracts = input.int(50, "Máximo de contratos", minval = 1, group = grpR)
commRt       = input.float(1.40, "Comisión ida y vuelta por contrato (USD)", minval = 0, step = 0.1, group = grpR)
slipTicks    = input.int(1, "Slippage por lado (ticks)", minval = 0, group = grpR)
maxLoss      = input.float(2000.0, "Maximum Loss Limit de la cuenta (USD)", minval = 0, group = grpR)

grpH = "Referencia histórica (actualízala con futbot)"
histWr   = input.float(31.0, "Acierto histórico (%)", group = grpH, tooltip = "Backtest NQ 2005-2020 de futbot (1.310 operaciones). Recalcúlalo con: python -m futbot stats --recipe nq_orb5_gap --symbol NQ")
histExpR = input.float(0.12, "Ganancia media por operación (R, neta)", group = grpH, tooltip = "+0,25R bruto; ~+0,12R neto con los costos actuales (ver docs/ESTRATEGIA_TRADINGVIEW.md).")

grpV = "Visual"
showBox     = input.bool(true, "Mostrar rango de apertura", group = grpV)
showSkipped = input.bool(true, "Mostrar días sin señal (y por qué)", group = grpV)
showPanel   = input.bool(true, "Mostrar panel", group = grpV)
panelPosStr = input.string("Arriba derecha", "Posición del panel", options = ["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"], group = grpV)
colBuy      = input.color(#1f9d55, "Color compras", group = grpV)
colSell     = input.color(#d64545, "Color ventas", group = grpV)

// ------------------------------------------------------------------- Utilidades
fR(float x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + "R"
fUsd(float x) => (x < 0 ? "-$" : "$") + str.tostring(math.abs(math.round(x)), "#,###")
fPx(float x) => str.tostring(x, format.mintick)

// ------------------------------------------------------------------- Tiempo (hora de Nueva York)
OPEN_MIN = 9 * 60 + 30
RTH_END  = 16 * 60
orEndMin = OPEN_MIN + orMin
exitMin  = exitHour * 60 + exitMinute
tMin     = hour(time, TZ) * 60 + minute(time, TZ)               // minuto de APERTURA de la barra
tcMin    = hour(time_close, TZ) * 60 + minute(time_close, TZ)   // minuto de CIERRE de la barra
dayKey   = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
inRth    = tMin >= OPEN_MIN and tMin < RTH_END
tfOk     = timeframe.isminutes and timeframe.multiplier <= orMin and orMin % timeframe.multiplier == 0
pvTrade  = contractSel == "NQ (mini, $20/punto)" ? 20.0 : 2.0
tick     = syminfo.mintick
slip     = slipTicks * tick

// ATR(14) de Wilder de la sesión diaria ANTERIOR (sin mirar el futuro)
atrPrev = request.security(syminfo.tickerid, "D", ta.atr(atrLen)[1], lookahead = barmerge.lookahead_on)

// ------------------------------------------------------------------- Cierre cash de ayer (16:00 NY)
var float curRthClose  = na
var float prevRthClose = na
var int   curRthDay    = na
if inRth
    if na(curRthDay) or dayKey != curRthDay
        prevRthClose := curRthClose
        curRthDay    := dayKey
    curRthClose := close

// ------------------------------------------------------------------- Rango de apertura
var int   orDay   = na
var int   orStart = na
var float orOpen  = na
var float orHigh  = na
var float orLow   = na
if inRth and tMin == OPEN_MIN
    orDay   := dayKey
    orStart := time
    orOpen  := open
    orHigh  := high
    orLow   := low
else if inRth and tMin < orEndMin and not na(orDay) and orDay == dayKey
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

// ------------------------------------------------------------------- Estado
var int    sigDir     = 0      // señal pendiente de entrar en la próxima barra
var float  sigStop    = na
var int    sigDay     = na
var int    posDir     = 0      // posición simulada abierta
var int    posDay     = na
var int    entryTime  = na
var float  entryPx    = na
var float  stopPx     = na
var float  tpPx       = na
var float  riskPts    = na
var int    posQty     = 0
var line   lnEntry    = na
var line   lnStop     = na
var line   lnTp       = na
var string todayText  = "Esperando la apertura (9:30 NY)"
var float  todayGap   = na
var int    statusDay  = na

// estadísticas sobre el historial del gráfico (por contrato, en R netos de costos)
var int   nTrades       = 0
var int   nWins         = 0
var float sumR          = 0.0
var float sumWinR       = 0.0
var float sumLossR      = 0.0
var int   curLossStreak = 0
var int   maxLossStreak = 0
var float cumR          = 0.0
var float peakR         = 0.0
var float maxDdR        = 0.0

if inRth and (na(statusDay) or dayKey != statusDay)
    statusDay := dayKey
    todayText := "Esperando el cierre de la vela de 9:30"
    todayGap  := na

isBuySig  = false
isSellSig = false

// ------------------------------------------------------------------- 1) Fin del rango: ¿hay señal?
orDone = barstate.isconfirmed and tfOk and inRth and not na(orDay) and orDay == dayKey and tcMin == orEndMin
if orDone
    dir      = close > orOpen ? 1 : close < orOpen ? -1 : 0
    rangeOk  = orHigh - orLow >= minRangeTick * tick
    gapAtr   = math.abs(orOpen - prevRthClose) / atrPrev
    gapOk    = not useGap or (not na(gapAtr) and gapAtr >= minGapAtr)
    dirOk    = dirMode == "Ambas" or (dirMode == "Solo compras" and dir > 0) or (dirMode == "Solo ventas" and dir < 0)
    stopEst  = dir > 0 ? orLow : orHigh
    riskEst  = math.abs(close - stopEst)
    qty      = riskEst > 0 ? math.min(maxContracts, int(math.floor(riskUsd / (riskEst * pvTrade)))) : 0
    fits     = qty >= 1
    todayGap := gapAtr
    if showBox
        box.new(orStart, orHigh, time_close, orLow, xloc = xloc.bar_time, border_color = color.new(color.gray, 30), bgcolor = color.new(color.gray, 85))
    reason = dir == 0 ? "vela doji" : not rangeOk ? "rango menor a " + str.tostring(minRangeTick) + " ticks" : not gapOk ? "gap " + (na(gapAtr) ? "sin datos" : str.tostring(gapAtr, "0.00")) + " ATR < " + str.tostring(minGapAtr, "0.00") : not dirOk ? "dirección filtrada" : ""
    if reason != ""
        todayText := "Sin señal hoy: " + reason
        if showSkipped
            label.new(time, orHigh, "Sin señal\n" + reason, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = size.small)
    else
        isLong   = dir > 0
        tpEst    = close + dir * targetR * riskEst
        qtyTxt   = fits ? str.tostring(qty) + (pvTrade == 20.0 ? " NQ" : " MNQ") + " (riesgo " + fUsd(qty * riskEst * pvTrade) + ")" : "NO cabe en tu riesgo de " + fUsd(riskUsd) + " (1 contrato arriesga " + fUsd(riskEst * pvTrade) + ")"
        txt = (isLong ? "▲ COMPRA" : "▼ VENTA") + " a mercado (9:35 NY)\n" + "Entrada ≈ " + fPx(close) + "\nStop " + fPx(stopEst) + "  (" + str.tostring(riskEst, "0.00") + " pts)" + "\nTP " + str.tostring(targetR, "0.#") + "R " + fPx(tpEst) + "\n" + qtyTxt + "\nSalir a las " + str.tostring(exitHour) + ":" + str.format("{0,number,00}", exitMinute) + " si no tocó stop/TP" + "\nGap " + str.tostring(gapAtr, "0.00") + " ATR" + "\nHistórico: gana " + str.tostring(histWr, "0") + "% · " + fR(histExpR) + "/op"
        label.new(time, isLong ? orLow : orHigh, txt, xloc = xloc.bar_time, style = isLong ? label.style_label_up : label.style_label_down, color = isLong ? colBuy : colSell, textcolor = color.white, size = size.small, textalign = text.align_left)
        alert("ORB5 NQ " + (isLong ? "COMPRA" : "VENTA") + " a mercado | Entrada ≈ " + fPx(close) + " | Stop " + fPx(stopEst) + " | TP " + fPx(tpEst) + " | " + qtyTxt + " | Salir " + str.tostring(exitHour) + ":" + str.format("{0,number,00}", exitMinute) + " NY", alert.freq_once_per_bar_close)
        isBuySig  := isLong
        isSellSig := not isLong
        if fits or not skipTooBig
            sigDir  := dir
            sigStop := stopEst
            sigDay  := dayKey
            posQty  := math.max(qty, 1)
            todayText := (isLong ? "COMPRA" : "VENTA") + " señalada: entrar a mercado ahora"
        else
            todayText := "Señal saltada: no cabe en tu riesgo"

// ------------------------------------------------------------------- 2) Entrada simulada en la barra siguiente
if barstate.isconfirmed and sigDir != 0 and not orDone
    if dayKey == sigDay and inRth
        e = open + sigDir * slip
        if (sigStop - e) * sigDir >= 0
            todayText := "Señal anulada: el precio abrió más allá del stop"
        else
            posDir    := sigDir
            posDay    := dayKey
            entryTime := time
            entryPx   := e
            stopPx    := sigStop
            riskPts   := math.abs(e - sigStop)
            tpPx      := math.round_to_mintick(e + sigDir * targetR * riskPts)
            exitTs     = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), exitHour, exitMinute, 0)
            lnEntry   := line.new(time, entryPx, exitTs, entryPx, xloc = xloc.bar_time, color = color.new(color.white, 20), width = 1)
            lnStop    := line.new(time, stopPx, exitTs, stopPx, xloc = xloc.bar_time, color = colSell, width = 2)
            lnTp      := line.new(time, tpPx, exitTs, tpPx, xloc = xloc.bar_time, color = colBuy, width = 1, style = line.style_dashed)
            todayText := (posDir > 0 ? "COMPRADO " : "VENDIDO ") + str.tostring(posQty) + (pvTrade == 20.0 ? " NQ" : " MNQ") + " desde " + fPx(entryPx)
    sigDir := 0

// ------------------------------------------------------------------- 3) Gestión: stop -> take profit -> hora de salida
if barstate.isconfirmed and posDir != 0
    sameBar    = time == entryTime
    hitStop    = posDir > 0 ? low <= stopPx : high >= stopPx
    hitTp      = posDir > 0 ? high >= tpPx + tick : low <= tpPx - tick
    exitPx     = float(na)
    exitReason = ""
    if dayKey != posDay
        exitPx     := open - posDir * slip
        exitReason := "fin de día"
    else if hitStop
        f           = sameBar ? stopPx : posDir > 0 ? math.min(open, stopPx) : math.max(open, stopPx)
        exitPx     := f - posDir * slip
        exitReason := "stop"
    else if hitTp
        exitPx     := sameBar ? tpPx : posDir > 0 ? math.max(open, tpPx) : math.min(open, tpPx)
        exitReason := "take profit"
    else if tcMin >= exitMin
        exitPx     := close - posDir * slip
        exitReason := "hora de salida"
    if exitReason != ""
        rNet = ((exitPx - entryPx) * posDir * pvTrade - commRt) / (riskPts * pvTrade)
        nTrades += 1
        sumR    += rNet
        if rNet > 0
            nWins         += 1
            sumWinR       += rNet
            curLossStreak := 0
        else
            sumLossR      += -rNet
            curLossStreak += 1
            maxLossStreak := math.max(maxLossStreak, curLossStreak)
        cumR   += rNet
        peakR  := math.max(peakR, cumR)
        maxDdR := math.max(maxDdR, peakR - cumR)
        line.set_x2(lnEntry, time_close)
        line.set_x2(lnStop, time_close)
        line.set_x2(lnTp, time_close)
        win = rNet > 0
        label.new(time, exitPx, (win ? "✔ " : "✖ ") + fR(rNet) + "\n" + exitReason, xloc = xloc.bar_time, style = label.style_label_left, color = win ? colBuy : colSell, textcolor = color.white, size = size.small)
        alert("ORB5 NQ: CERRAR posición (" + exitReason + ") ≈ " + fPx(exitPx) + " | Resultado " + fR(rNet), alert.freq_once_per_bar_close)
        todayText := "Cerrada por " + exitReason + ": " + fR(rNet) + " (" + fUsd(rNet * riskUsd) + " con tu riesgo)"
        posDir := 0

// ------------------------------------------------------------------- Marcas y alertas simples
plotshape(isBuySig, "Señal de compra", shape.triangleup, location.belowbar, colBuy, size = size.tiny)
plotshape(isSellSig, "Señal de venta", shape.triangledown, location.abovebar, colSell, size = size.tiny)
alertcondition(isBuySig, "ORB5 NQ: compra", "ORB5 NQ: señal de COMPRA a mercado (9:35 NY). Revisa stop y tamaño en el gráfico.")
alertcondition(isSellSig, "ORB5 NQ: venta", "ORB5 NQ: señal de VENTA a mercado (9:35 NY). Revisa stop y tamaño en el gráfico.")

// ------------------------------------------------------------------- Panel
panelPos = panelPosStr == "Arriba izquierda" ? position.top_left : panelPosStr == "Abajo derecha" ? position.bottom_right : panelPosStr == "Abajo izquierda" ? position.bottom_left : position.top_right
var table panel = table.new(panelPos, 2, 14, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)

cell(int row, string k, string v, color vc) =>
    table.cell(panel, 0, row, k, text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, row, v, text_color = vc, text_size = size.small, text_halign = text.align_right)

if showPanel and barstate.islast
    wr   = nTrades > 0 ? 100.0 * nWins / nTrades : na
    avgR = nTrades > 0 ? sumR / nTrades : na
    pf   = sumLossR > 0 ? sumWinR / sumLossR : na
    okSym = syminfo.root == "NQ" or syminfo.root == "MNQ"
    table.cell(panel, 0, 0, "ORB 5m NQ · futbot", text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(panel, 1, 0, okSym ? syminfo.ticker : "⚠ validado sólo en NQ/MNQ", text_color = okSym ? color.gray : color.orange, text_size = size.small)
    liveTxt = posDir != 0 ? todayText + " · ahora " + fR((close - entryPx) * posDir / riskPts) : todayText
    cell(1, "Hoy", tfOk ? liveTxt : "⚠ Usa un gráfico de 1 o 5 minutos", tfOk ? color.white : color.orange)
    cell(2, "Gap de hoy", na(todayGap) ? "—" : str.tostring(todayGap, "0.00") + " ATR " + (todayGap >= minGapAtr ? "✔" : "✖"), color.white)
    cell(3, "Riesgo por operación", fUsd(riskUsd) + " · " + (pvTrade == 20.0 ? "NQ" : "MNQ"), color.white)
    cell(4, "Pérdidas seguidas hasta el MLL", str.tostring(math.floor(maxLoss / riskUsd)), color.white)
    cell(5, "── En este gráfico ──", str.tostring(nTrades) + " operaciones", color.gray)
    cell(6, "Acierto", na(wr) ? "—" : str.tostring(wr, "0") + "%", color.white)
    cell(7, "Ganancia media", na(avgR) ? "—" : fR(avgR), na(avgR) ? color.white : avgR >= 0 ? colBuy : colSell)
    cell(8, "Profit factor", na(pf) ? "—" : str.tostring(pf, "0.00"), color.white)
    cell(9, "Total con tu riesgo", fUsd(sumR * riskUsd), sumR >= 0 ? colBuy : colSell)
    cell(10, "Peor racha / caída máx.", str.tostring(maxLossStreak) + " pérdidas · " + fUsd(-maxDdR * riskUsd), color.white)
    cell(11, "── Histórico (futbot) ──", "NQ 2005-2020", color.gray)
    cell(12, "Acierto / ganancia media", str.tostring(histWr, "0") + "% · " + fR(histExpR), color.white)
    cell(13, "Pocas operaciones = mucha suerte", "mira el histórico", color.gray)
